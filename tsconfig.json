{
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "composite": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSourceMap": true,
    "jsx": "react",
    "module": "ES6",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noLib": false,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "suppressImplicitAnyIndexErrors": true,
    "target": "es3",
    "typeRoots": ["app/src/@types", "server/src/@types", "node_modules/@types"],
    "paths": {
      "@rkta-starter/client": ["app"],
      "@rkta-starter/server": ["server"]
    }
  },
  "exclude": [".dev", ".now", "build", "node_modules", "public", "scripts", "webpack.config.js"],
  "include": ["src/**/*"],
  "references": [
    { "path": "app" },
    { "path": "server" }
  ]
}
