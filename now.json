{
  "env": {
    "CLIENT__APP_CONTAINER": "rkta-app",
    "CLIENT__CACHE_CONTAINER": "cache",
    "CLIENT__LOGUX_DEFAULT_USER": "guest",
    "CLIENT__LOGUX_DEFAULT_TOKEN": "guest",
    "CLIENT__LOGUX_URL": "wss://starter.rkta.now.sh/",
    "CLIENT__HTTP_BASE": "/",
    "LOGUX_MODE": "production",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/vercel-serverless.ts": {
      "includeFiles": "build/stats.json"
    }
  },
  "routes": [
    {
      "src": "[^(.js|favicons)]",
      "dest": "/api/vercel-serverless.ts",
      "headers": {
        "Cache-Control": "s-maxage=900000, max-age=0",
        "Strict-Transport-Security": "max-age=31622400000;",
        "Content-Security-Policy": "default-src 'self'; frame-ancestors 'none'; img-src 'self' *.sd.lk; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src https://sdlk-graphql.now.sh/",
        "X-Frame-Options": "DENY",
        "X-DNS-Prefetch-Control": "off",
        "X-Download-Options": "noopen",
        "X-XSS-Protection": "1; mode=block",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "(.*)",
      "dest": "/public$1"
    }
  ],
  "scope": "rkta",
  "version": 2
}