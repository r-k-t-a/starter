{
  "name": "rkta-starter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preanalize": "npm run build:client",
    "analyze": "webpack-bundle-analyzer build/stats.json",
    "build:client": "NODE_ENV=production TS_NODE_PROJECT=tsconfig-webpack.json webpack --profile --json > build/stats.json",
    "build:server": "rollup -c ./rollup.config.js",
    "clean": "rimraf build",
    "prebuild": "npm run clean && npm run lint",
    "build": "npm run build:client && npm run build:server",
    "dev:server": "node  -r esm -r ts-node/register src/server",
    "dev": "nodemon -e ts,tsx -w ./src/server -x npm run dev:server",
    "lint": "eslint 'src' --ext .ts,.tsx",
    "start": "node -r esm build/server",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "npm run typecheck -- --watch"
  },
  "description": "",
  "dependencies": {
    "@apollo/react-hooks": "^3.1.4",
    "@apollo/react-ssr": "^3.1.4",
    "@emotion/core": "^10.0.28",
    "@emotion/styled": "^10.0.27",
    "@rkta/entypo": "^0.0.117",
    "@rkta/ui": "^0.0.117",
    "@types/react-router-dom": "^5.1.3",
    "apollo-cache-inmemory": "^1.6.5",
    "apollo-client": "^2.6.8",
    "apollo-link": "^1.2.13",
    "apollo-link-context": "^1.0.19",
    "apollo-link-http": "^1.5.16",
    "apollo-link-state": "^0.4.2",
    "dotenv": "^8.2.0",
    "graphql": "^14.6.0",
    "graphql-tag": "^2.10.3",
    "isomorphic-unfetch": "^3.0.0",
    "koa": "^2.11.0",
    "koa-bodyparser": "^4.3.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-router": "^8.0.8",
    "koa-static": "^5.0.0",
    "lodash": "^4.17.15",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-helmet-async": "^1.0.4",
    "react-router-dom": "^5.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^11.0.2",
    "@rollup/plugin-node-resolve": "^7.1.1",
    "@types/enzyme": "^3.10.5",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^25.1.5",
    "@types/koa": "^2.11.3",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-logger": "^3.1.1",
    "@types/koa-router": "^7.4.0",
    "@types/koa-static": "^4.0.1",
    "@types/koa-webpack": "^5.0.1",
    "@types/lodash": "^4.14.149",
    "@types/react": "^16.9.32",
    "@types/react-dom": "^16.9.6",
    "@types/react-helmet": "^5.0.15",
    "@types/webpack-env": "^1.15.1",
    "@types/webpack-node-externals": "^1.7.1",
    "@typescript-eslint/eslint-plugin": "^2.26.0",
    "@typescript-eslint/parser": "^2.26.0",
    "clean-webpack-plugin": "^3.0.0",
    "cross-env": "^7.0.2",
    "enzyme": "^3.11.0",
