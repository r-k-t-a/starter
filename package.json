    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^3.0.0",
    "esm": "^3.2.25",
    "jest": "^25.2.7",
    "jest-emotion": "^10.0.32",
    "jest-transform-graphql": "^2.1.0",
    "koa-webpack": "^5.3.0",
    "nodemon": "^2.0.2",
    "prettier": "^2.0.2",
    "react-helmet": "^5.2.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.4.0",
    "rollup-plugin-typescript2": "^0.27.0",
    "ts-jest": "^25.3.1",
    "ts-loader": "^6.2.2",
